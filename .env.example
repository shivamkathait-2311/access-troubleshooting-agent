# ==================== Environment ====================
ENV=development
DEBUG=true
LOG_LEVEL=INFO

# ==================== Server ====================
HOST=0.0.0.0
PORT=8000

# ==================== Database ====================
DATABASE_URL=postgresql+asyncpg://ata_user:ata_password@localhost:5433/ata_db
AUDIT_DB_SCHEMA=audit

# ==================== Redis ====================
# Ports 5433/6380 (not the 5432/6379 defaults) match docker-compose.yml's
# host-port remap, done to avoid clashing with other local services.
REDIS_URL=redis://localhost:6380/0

# ==================== Secrets (Vault) ====================
VAULT_ADDR=http://localhost:8200
VAULT_ROLE=access-troubleshooting-agent

# ==================== LLM ====================
OPENAI_API_KEY=
OPENAI_INTAKE_MODEL=gpt-4o-mini
OPENAI_EXPLANATION_MODEL=gpt-4o-mini

# ==================== Policy store ====================
POLICY_DIR=app/policy/policies

# ==================== Intake surfaces ====================
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
TEAMS_APP_ID=
TEAMS_APP_SECRET=

# ==================== Audit / SIEM ====================
SIEM_ENDPOINT=

# ==================== OpenIAM ====================
OPENIAM_BASE_URL=https://your-openiam-host
OPENIAM_CLIENT_ID=
OPENIAM_CLIENT_SECRET=
OPENIAM_ADMIN_USERNAME=
OPENIAM_ADMIN_PASSWORD=
OPENIAM_REDIRECT_URI=
OPENIAM_OAUTH_RESPONSE_TYPE=token
OPENIAM_TOKEN_REFRESH_MARGIN_SECONDS=60
OPENIAM_PASSWORD_RESET_URL_TEMPLATE={base_url}/idp/auth-select?reqAuthTypes=PASSWORD_AUTH,PUSH_AUTH,CERT_AUTH,SMS_AUTH,VOICE_AUTH,CHALLENGE_RESPONSE_AUTH,DUO_AUTH,TOTP_AUTH,CRIIPTO_AUTH,KERB_AUTH,WEB_AUTH,EMAIL_AUTH&login={login}&postbackUrl=%2Fidp%2FresetPasswordForm%3Flogin%3D{login}

# ==================== Diagnostic funnel ====================
DIAGNOSTIC_AUTH_EVENTS_LOOKBACK_HOURS=24
DEFAULT_SYSTEM_ID=openiam

# ==================== Kill switch ====================
AGENT_KILL_SWITCH_ENABLED=false
REMEDIATION_KILL_SWITCH_ENABLED=false

# ==================== Observability ====================
ENABLE_METRICS=true
